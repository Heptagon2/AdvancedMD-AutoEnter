def calibrate_positions(gui_status_callback=None):
    """Calibrate cursor positions for all form fields"""
    print("Calibrating cursor positions...")
    print("For each field, hover your mouse over the text box and press ` to save the position")
    print("You can press Ctrl+C at any time to cancel calibration")
    
    coordinates = {}
    fields = [
        ("Patient Name", "namexy"),
        ("Visit button", "visitxy"),
        ("Facility button", "facilityxy"),
        ("Extra Info button", "infoxy"),
        #("Primary Phone Number", "primaryphonenumberxy"),
       # ("Address", "addressxy"),
        #("ZIP Code", "zipcodexy")
    ]
    
    for field_name, coord_key in fields:
        if gui_status_callback:
            gui_status_callback(f"Calibrating: {field_name}")
        print(f"\nHover over {field_name} text box and press ` to save position")
        print("Press Ctrl+C to cancel")
        
        stop_event = threading.Event()
        
        def listen_for_kill_key():
            try:
                keyboard.wait('~')
                stop_event.set()
            except KeyboardInterrupt:
                print("\nCalibration cancelled.")
                sys.exit(1)
        
        # Start the kill-key listener in the background
        threading.Thread(target=listen_for_kill_key, daemon=True).start()
        
        # Main loop: print mouse position until kill key is pressed
        while not stop_event.is_set():
            try:
                print(f"\rCurrent position: {pyautogui.position()}", end="", flush=True)
                time.sleep(0.1)
            except KeyboardInterrupt:
                print("\nCalibration cancelled.")
                sys.exit(1)
        
        position = pyautogui.position()
        coordinates[coord_key] = {"x": position.x, "y": position.y}
        print(f"\n{field_name} position saved: {position}")
        stop_event.clear()
        time.sleep(0.5)
    
    if gui_status_callback:
        gui_status_callback("")
    return coordinates

def get_monitor_under_mouse():
    """Find the monitor where the mouse is currently located."""
    mouse_x, mouse_y = pyautogui.position()

    with mss.mss() as sct:
        for i, monitor in enumerate(sct.monitors[1:], start=1):  # Skip [0], which is all monitors
            x1 = monitor["left"]
            y1 = monitor["top"]
            x2 = x1 + monitor["width"]
            y2 = y1 + monitor["height"]

            if x1 <= mouse_x < x2 and y1 <= mouse_y < y2:
                return i  # Return monitor index instead of dict

        # If no monitor found (edge case), return primary monitor index
        if len(sct.monitors) > 1:
            return 1
    
    return None

def screenshot_active_monitor():
    monitor_index = get_monitor_under_mouse()
    if monitor_index is None:
        print("Could not determine monitor under mouse.")
        return

    with mss.mss() as sct:
        # Get fresh monitor info and capture
        monitor = sct.monitors[monitor_index]
        screenshot = sct.grab(monitor)
        mss.tools.to_png(screenshot.rgb, screenshot.size, output="monitor_under_mouse.png")
        print(f"Screenshot saved as monitor_under_mouse.png (Monitor {monitor_index}: {monitor['width']}x{monitor['height']} at {monitor['left']},{monitor['top']})")

def extract_patient_info(image_path):
    """Extract patient information from screenshot using Gemini AI"""
    try:
        # Set API key from environment variable
        api_key = os.getenv("GEMINI_API_KEY")
        if not api_key:
            try:
                tk.messagebox.showerror(
                    "Error",
                    "GEMINI_API_KEY not found.\n\n"
                    "Make sure a .env file exists next to the executable and contains:\n"
                    "GEMINI_API_KEY=your_api_key_here",
                )
            except Exception:
                pass
            raise ValueError("GEMINI_API_KEY not found in environment variables. Please check your .env file.")
        
        genai.configure(api_key=api_key)
        
        # Load image from file
        with open(image_path, "rb") as f:
            image_bytes = f.read()
        
        # Select model
        model = genai.GenerativeModel(model_name="gemini-2.5-flash")
        
        # Generate response
        response = model.generate_content([
            {
                "role": "user",
                "parts": [
                    {"inline_data": {"mime_type": "image/png", "data": image_bytes}},
                    {
                        "text": (
                            "From the image provided, extract ONLY the following information, "
                            "in this exact order, one item per line:\n"
                            "1) FULL patient name in the format: Last, First Middle\n"
                            "2) Date of admission/arrival (date only, no time; format as MM/DD/YYYY)\n"
                            "3) Date of discharge (date only, no time; format as MM/DD/YYYY). "
                            "If the patient has NOT yet been discharged, output exactly '1/1/2000' for this line.\n"
                            "4) ICD-10-CM code for the most important neurology-related final diagnosis\n"
                            "5) ICD-10-CM code for the second neurology-related final diagnosis (if any)\n"
                            "6) ICD-10-CM code for the third neurology-related final diagnosis (if any)\n"
                            "7) ICD-10-CM code for the fourth neurology-related final diagnosis (if any)\n\n"
                            "ICD-10-CM code rules (lines 4-7):\n"
                            "- You will see a list of final diagnoses from all fields of medicine. "
                            "Choose ONLY the codes that clearly correspond to conditions a neurologist would diagnose.\n"
                            "- ICD-10-CM codes are for billing and must justify the need for a neurologist; "
                            "do NOT include codes that are not clearly neurology-related.\n"
                            "- You are strongly encouraged to find multiple appropriate codes (up to four), "
                            "but suitability is more important than quantity.Usually 2-3 is normal for the average patient.\n"
                            "- If there are more than four applicable neurology codes, choose the four that are most "
                            "clinically significant and most clearly require neurological expertise.\n"
                            "- If you are unsure or cannot confidently justify including a code, do NOT include it.\n"
                            "- If there are fewer than four suitable neurology-related codes, fill the remaining lines "
                            "with exactly 'NANA'. It is better to use 'NANA' than to force a weak or incorrect code.\n"
                            "- For each code line that is NOT 'NANA', output the code, followed by '~', followed by the "
                            "exact description from the image (for example: G81.90~Hemiplegia, unspecified side).\n"
                            "- If you output 'NANA' on a line, do NOT include any description on that line.\n\n"
                            "Formatting and constraints:\n"
                            "- Output exactly SEVEN lines and nothing else.\n"
                            "- Do NOT include any labels [ 1), 2), 3), etc ], bullet points, or extra words. Only output the requested values.\n"
                            "- Do NOT give any information that is under the text 'IP Adm. Date/Time Admit Category'.\n"
                            "- If you cannot find enough information for the patient name, arrival date, or discharge date, "
                            "output the text 'could not find' for that specific line.\n"
                            "- ICD-10-CM codes ALWAYS start with a letter. Be very careful not to confuse the letter 'I' "
                            "with the digit '1'. If it appears that a code starts with '1', you are wrong, and it should be 'I'.\n"
                            "- Omit any '[P]' markers; they are not part of the actual ICD-10-CM codes.\n"
                        )
                    },
                ]
            }
        ])
        
        return response.text
    except Exception as e:
        print(f"Error extracting information from image: {e}")
        return None

def unpack_response(response):
    """Parse the AI response into individual fields"""
    try:
        lines = response.strip().split('\n')
        if len(lines) >= 6:
            PatientNameFull = lines[0].strip()
            ArrivalTime = lines[1].strip()
            DischargeTime = lines[2].strip()
            ICDCode1 = lines[3].strip()
            ICDCode2 = lines[4].strip()
            ICDCode3 = lines[5].strip()
            ICDCode4 = lines[6].strip()

            PatientName = PatientNameFull

            
            return PatientName, ArrivalTime, DischargeTime, ICDCode1, ICDCode2, ICDCode3, ICDCode4
        else:
            print("Error: AI response doesn't contain enough information")
            return None
    except Exception as e:
        print(f"Error parsing AI response: {e}")
        return None

