def load_coordinates():
    """Load saved coordinates from file"""
    try:
        with open(get_data_path("chargeCoordinates.json"), "r") as f:
            return json.load(f)
    except FileNotFoundError:
        return None
    except json.JSONDecodeError:
        tk.messagebox.showerror("Error", "chargeCoordinates.json is corrupted. Please delete it and recalibrate.")
        return None

def save_coordinates(coordinates):
    """Save coordinates to file"""
    with open(get_data_path("chargeCoordinates.json"), "w") as f:
        json.dump(coordinates, f, indent=2)

