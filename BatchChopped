def calibrate_positions(gui_status_callback=None):
    """Calibrate cursor positions for all form fields"""
    print("Calibrating cursor positions...")
    print("For each field, hover your mouse over the text box and press ` to save the position")
    print("You can press Ctrl+C at any time to cancel calibration")
    
    coordinates = {}
    fields = [
        ("Patient Name", "namexy"),
        ("Date of Birth", "dateofbirthxy"),
        ("MRN Number", "mrnnumberxy"),
        ("Sex", "sexxy"),
        ("Primary Phone Number Icon", "primaryphonenumberxy"),
        ("Primary Phone Number", "primaryphonenumberxy2"),
        ("Primary Phone Number Prefered", "primaryphonenumberxy3"),
        ("Address", "addressxy"),
        ("ZIP Code", "zipcodexy")
    ]
    
    for field_name, coord_key in fields:
        if gui_status_callback:
            gui_status_callback(f"Calibrating: {field_name}")
        print(f"\nHover over {field_name} text box and press ` to save position")
        print("Press Ctrl+C to cancel")
        
        stop_event = threading.Event()
        
        def listen_for_kill_key():
            try:
                keyboard.wait('~')
                stop_event.set()
            except KeyboardInterrupt:
                print("\nCalibration cancelled.")
                sys.exit(1)
        
        # Start the kill-key listener in the background
        threading.Thread(target=listen_for_kill_key, daemon=True).start()
        
        # Main loop: print mouse position until kill key is pressed
        while not stop_event.is_set():
            try:
                print(f"\rCurrent position: {pyautogui.position()}", end="", flush=True)
                time.sleep(0.1)
            except KeyboardInterrupt:
                print("\nCalibration cancelled.")
                sys.exit(1)
        
        position = pyautogui.position()
        coordinates[coord_key] = {"x": position.x, "y": position.y}
        print(f"\n{field_name} position saved: {position}")
        stop_event.clear()
        time.sleep(0.5)
    
    if gui_status_callback:
        gui_status_callback("")
    return coordinates

def get_monitor_under_mouse():
    """Find the monitor where the mouse is currently located."""
    mouse_x, mouse_y = pyautogui.position()

    with mss.mss() as sct:
        for monitor in sct.monitors[1:]:  # Skip [0], which is all monitors
            x1 = monitor["left"]
            y1 = monitor["top"]
            x2 = x1 + monitor["width"]
            y2 = y1 + monitor["height"]

            if x1 <= mouse_x < x2 and y1 <= mouse_y < y2:
                return monitor

    return None

def screenshot_active_monitor():
    monitor = get_monitor_under_mouse()
    if monitor is None:
        print("Could not determine monitor under mouse.")
        return

    with mss.mss() as sct:
        screenshot = sct.grab(monitor)
        mss.tools.to_png(screenshot.rgb, screenshot.size, output="monitor_under_mouse.png")
        print("Screenshot saved as monitor_under_mouse.png")


def extract_patient_info(image_path):
    """Extract patient information from screenshot using Gemini AI"""
    try:
        # Set API key from environment variable
        api_key = os.getenv("GEMINI_API_KEY")
        if not api_key:
            raise ValueError("GEMINI_API_KEY not found in environment variables. Please check your .env file.")
        genai.configure(api_key=api_key)
        
        # Load image from file
        with open(image_path, "rb") as f:
            image_bytes = f.read()
        
        # Select model
        model = genai.GenerativeModel(model_name="gemini-2.5-flash")
        
        # Generate response
        response = model.generate_content([
            {
                "role": "user",
                "parts": [
                    {"inline_data": {"mime_type": "image/png", "data": image_bytes}},
                    {"text": """Please identify the the FULL patient/member name(Last, First Middle), date of birth, MRN number, sex, 
                     primary phone number, COMPLETE address (with BOTH house number AND street name. Do not include city or state), and ZIP code from the image provided.
                      Format your response in a list, in that order, ommitting any labels or other infomation other than the output. Omit 
                     any bullet points. Do not give any infomation on the provider. It is extremely important that you give the requested 
                     infomation in the order and format specified, and you should under no circumstances stray from that format. If you 
                     cannot find enough infomation to fill the seven requested fields, state could not find, in place of that peice of 
                     infomation. In the case that you cannot find an MRN number, do not state could not find, but instead fill the field 
                     with only a '~'.You should under all circumstances still have a list of seven values, no matter what the values may be."""}
                ]
            }
        ])
        
        return response.text
    except Exception as e:
        print(f"Error extracting information from image: {e}")
        return None

def unpack_response(response):
    """Parse the AI response into individual fields and clean address/ZIP"""
    try:
        lines = [line.strip() for line in response.strip().split('\n') if line.strip()]
        
        if len(lines) < 6:
            print("Error: AI response doesn't contain enough information.")
            print("You will have to manually change the information.")

            # Field names and labels to prompt the user
            field_names = ["PatientName", "DateOfBirth", "MRNNumber", "Sex", "PrimaryPhoneNumber", "Address", "ZipCode"]
            prompts = ["Patient name", "Date of birth", "MRN Number", "Sex", "Primary phone number", "Address", "ZIP Code"]

            # Temporary storage for values
            data = {}

            for i, (field, prompt) in enumerate(zip(field_names, prompts)):
                if i < len(lines):
                    value = lines[i]
                else:
                    value = "MISSING"

                print(f"{prompt} is: {value}")
                confirmation = input("Press Enter to confirm, or type 'no' to change: ").strip().lower()
                if confirmation == "no":
                    corrected = input(f"Type in correction for {prompt}: ").strip()
                else:
                    corrected = value

                # For ZipCode, trim to 5 digits
                if field == "ZipCode":
                    corrected = corrected[:5]

                data[field] = corrected

            # Unpack variables
            PatientName = data["PatientName"]
            DateOfBirth = data["DateOfBirth"]
            MRNNumber = data["MRNNumber"]
            Sex = data["Sex"]
            PrimaryPhoneNumber = data["PrimaryPhoneNumber"]
            Address = data["Address"]
            ZipCode = data["ZipCode"]

        if len(lines) == 7:
                PatientName = lines[0]
                DateOfBirth = lines[1]
                MRNNumber = lines[2]
                Sex = lines[3]
                PrimaryPhoneNumber = lines[4]
                Address = lines[5]
                ZipCode = lines[6][:5]
        
        
        return PatientName, DateOfBirth, MRNNumber, Sex, PrimaryPhoneNumber, Address, ZipCode

    except Exception as e:
        print(f"Error parsing AI response: {e}")
        return None
    

