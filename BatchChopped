class BatchChoppedApp:
    def __init__(self, master=None, cli_mode=False):
        self.cli_mode = cli_mode
        self.master = master
        self.hotkey_enabled = False
        self.calibration_step_event = threading.Event()
        self.calibrating = False
        if not cli_mode:
            self.master.title("BatchChopped - AutoEnter V2")
            self.status_var = tk.StringVar()
            self.status_label = tk.Label(master, textvariable=self.status_var)
            self.status_label.pack()
            self.main_frame = tk.Frame(master)
            self.main_frame.pack()
            self.build_gui()
            self.review_frame = None
            self.quit_btn = tk.Button(master, text="Quit", command=self.quit_app)
            self.quit_btn.pack(pady=5)
            self.master.protocol("WM_DELETE_WINDOW", self.quit_app)
            keyboard.add_hotkey('`', self.global_hotkey_handler)
        self.coordinates = None
        self.image_paths = []
        self.current_idx = 0
        self.patient_data = None
        self.review_entries = []
        if not self.cli_mode:
            self.coordinates = load_coordinates()
            if not self.coordinates:
                self.show_info("No saved coordinates found. Please calibrate before continuing.")

    def log(self, msg):
        if self.cli_mode:
            print(msg)
        else:
            self.status_var.set(msg)
            self.master.update_idletasks()

    def ask_input(self, prompt):
        if self.cli_mode:
            return input(prompt)
        else:
            # Simple input dialog
            from tkinter.simpledialog import askstring
            return askstring("Input", prompt)

    def ask_yesno(self, prompt):
        if self.cli_mode:
            return input(f"{prompt} (yes/no): ").strip().lower() in ["yes", "y"]
        else:
            return tk.messagebox.askyesno("Confirm", prompt)

    def show_error(self, msg):
        if self.cli_mode:
            print(f"ERROR: {msg}")
        else:
            tk.messagebox.showerror("Error", msg)

    def show_info(self, msg):
        if self.cli_mode:
            print(msg)
        else:
            tk.messagebox.showinfo("Info", msg)

    def build_gui(self):
        self.select_btn = tk.Button(self.main_frame, text="Select Input File", command=self.select_input_gui)
        self.select_btn.pack(padx=100,pady=5)
        self.calib_btn = tk.Button(self.main_frame, text="Calibrate Positions", command=self.calibrate_positions_gui)
        self.calib_btn.pack(pady=5)
        # Toggle hotkey/manual mode
        self.toggle_btn = tk.Button(self.main_frame, text="Hotkey Mode: OFF", command=self.toggle_hotkey_mode)
        self.toggle_btn.pack(pady=5)

    def select_input_gui(self):
        self.image_paths = select_input()
        if self.image_paths:
            self.log(f"Selected {len(self.image_paths)} images.")
            self.process_images(self.image_paths)

    def calibrate_positions_gui(self):
        self.calibrating = True
        def status_callback(msg):
            self.status_var.set(msg)
            self.master.update_idletasks()
        self.coordinates = self.calibrate_positions(gui_status_callback=status_callback)
        save_coordinates(self.coordinates)
        self.log("Calibration complete.")
        self.calibrating = False

    def calibrate_positions(self, gui_status_callback=None):
        print("Calibrating cursor positions...")
        print("For each field, hover your mouse over the text box and press ` to save the position")
        print("You can press Ctrl+C at any time to cancel calibration")
        coordinates = {}
        fields = [
            ("Patient Name", "namexy"),
            ("Date of Birth", "dateofbirthxy"),
            ("MRN Number", "mrnnumberxy"),
            ("Sex", "sexxy"),
            ("Primary Phone Number Icon", "primaryphonenumberxy"),
            ("Primary Phone Number", "primaryphonenumberxy2"),
            ("Primary Phone Number Prefered", "primaryphonenumberxy3"),
            ("Address", "addressxy"),
            ("ZIP Code", "zipcodexy")
        ]
        for field_name, coord_key in fields:
            if gui_status_callback:
                gui_status_callback(f"Calibrating: {field_name}")
            print(f"\nHover over {field_name} text box and press ` to save position")
            print("Press Ctrl+C to cancel")
            self.calibration_step_event.clear()
            while True:
                try:
                    if self.calibration_step_event.wait(timeout=0.1):
                        break
                except KeyboardInterrupt:
                    print("\nCalibration cancelled.")
                    sys.exit(1)
                print(f"\rCurrent position: {pyautogui.position()}", end="", flush=True)
            position = pyautogui.position()
            coordinates[coord_key] = {"x": position.x, "y": position.y}
            print(f"\n{field_name} position saved: {position}")
            time.sleep(0.5)
        if gui_status_callback:
            gui_status_callback("")
        return coordinates

    def quit_app(self):
        if self.cli_mode:
            exit(0)
        else:
            self.master.destroy()

    def global_hotkey_handler(self):
        if self.calibrating:
            self.calibration_step_event.set()
        elif self.hotkey_enabled:
            self.take_and_process_screenshot()

    def take_and_process_screenshot(self):
        screenshot_active_monitor()
        image_path = "monitor_under_mouse.png"
        self.process_images([image_path])

    def process_images(self, image_paths):
        if not self.coordinates:
            self.coordinates = load_coordinates()
        if not self.coordinates:
            self.show_info("No saved coordinates found. Please calibrate before continuing.")
            self.calibrate_positions_gui()
            if not self.coordinates:
                self.show_error("Calibration failed or cancelled. Cannot continue.")
                return
        for idx, image_path in enumerate(image_paths):
            self.log(f"Processing {image_path} ({idx+1}/{len(image_paths)})...")
            response = extract_patient_info(image_path)
            if response is None:
                self.show_error(f"Failed to extract info from {image_path}")
                continue
            patient_data = unpack_response(response)
            if patient_data is None:
                self.show_error(f"Failed to parse info from {image_path}")
                continue
            self.patient_data = patient_data
            confirmed, edited_data = self.review_and_confirm(patient_data)
            if not confirmed:
                self.log("Data entry cancelled or not confirmed. Skipping this entry.")
                continue
            # enter_data is now called from review_and_confirm
            try:
                os.remove(image_path)
                self.log(f"Deleted {image_path}")
            except Exception as e:
                self.show_error(f"Could not delete {image_path}: {e}")
        #self.show_info("Batch processing complete!")

    def review_and_confirm(self, patient_data):
        if self.cli_mode:
            # Terminal mode: print and allow manual edit
            fields = ["Name", "Date of Birth", "MRN Number", "Sex", "Primary Phone Number", "Address", "ZIP"]
            edited = list(patient_data)
            for i, (f, v) in enumerate(zip(fields, patient_data)):
                print(f"{f}: {v}")
                resp = input(f"Edit {f}? (leave blank to keep): ").strip()
                if resp:
                    edited[i] = resp
            confirm = input("Is the extracted information correct? (yes/no): ").strip().lower() in ["yes", "y"]
            if not confirm:
                print("Data entry cancelled.")
                return False, edited
            ready = input("Are you ready to paste the information? (yes/no): ").strip().lower() in ["yes", "y"]
            if not ready:
                print("Data entry cancelled.")
                return False, edited
            return True, edited
        else:
            # GUI mode: show editable fields in a modal dialog
            result = {'confirmed': False, 'edited': list(patient_data)}
            dialog = tk.Toplevel(self.master)
            dialog.title("Review Extracted Data")
            fields = ["Name", "Date of Birth", "MRN Number", "Sex", "Primary Phone Number", "Address", "ZIP"]
            entries = []
            for i, (f, v) in enumerate(zip(fields, patient_data)):
                tk.Label(dialog, text=f).grid(row=i, column=0, sticky='e')
                entry = tk.Entry(dialog, width=40)
                entry.insert(0, v)
                entry.grid(row=i, column=1)
                entries.append(entry)
            # Add warning label
            warning = tk.Label(dialog, text="Please ensure the target application is active and ready to receive input. You have 5 seconds to switch to the target application before auto-entry begins.", fg="red", wraplength=350, justify="left")
            warning.grid(row=len(fields), column=0, columnspan=2, pady=(10,0))
            def on_confirm():
                result['confirmed'] = True
                result['edited'] = [e.get() for e in entries]
                dialog.destroy()
                # Start auto-entry after closing dialog
                self.master.after(100, lambda: self.master.after(5000, lambda: enter_data(self.coordinates, result['edited'])))
            def on_cancel():
                result['confirmed'] = False
                dialog.destroy()
            btn_frame = tk.Frame(dialog)
            btn_frame.grid(row=len(fields)+1, column=0, columnspan=2, pady=10)
            confirm_btn = tk.Button(btn_frame, text="Confirm and Continue", command=on_confirm)
            confirm_btn.pack(side='left', padx=5)
            cancel_btn = tk.Button(btn_frame, text="Cancel Entry", command=on_cancel)
            cancel_btn.pack(side='left', padx=5)
            dialog.transient(self.master)
            dialog.grab_set()
            self.master.wait_window(dialog)
            if not result['confirmed']:
                return False, patient_data
            return True, result['edited']

    def toggle_hotkey_mode(self):
        self.hotkey_enabled = not self.hotkey_enabled
        if self.hotkey_enabled:
            self.toggle_btn.config(text="Hotkey Mode: ON")
        else:
            self.toggle_btn.config(text="Hotkey Mode: OFF")

