def resource_path(relative_path):
    """ Get absolute path to resource, works for dev and for PyInstaller .exe """
    try:
        base_path = sys._MEIPASS
    except Exception:
        base_path = os.path.abspath(".")
    return os.path.join(base_path, relative_path)

def get_data_path(filename):
    """ Get path for data files that should persist between app runs """
    # Use the directory where the exe is located, or current directory for dev
    try:
        # If running as exe, use the exe's directory
        if getattr(sys, 'frozen', False):
            base_path = os.path.dirname(sys.executable)
        else:
            base_path = os.path.abspath(".")
    except Exception:
        base_path = os.path.abspath(".")
    return os.path.join(base_path, filename)

def convert_pdf_to_images(pdf_path, output_folder="output_images"):
    os.makedirs(output_folder, exist_ok=True)
    images = convert_from_path(pdf_path, dpi=300)
    
    image_path = []
    for i, img in enumerate(images):
        img_pathSingle = os.path.join(output_folder, f"page_{i+1}.png")
        img.save(img_pathSingle, "PNG")
        image_path.append(img_pathSingle)
    
    return image_path

def load_coordinates():
    """Load saved coordinates from file"""
    try:
        with open(get_data_path("coordinates.json"), "r") as f:
            return json.load(f)
    except FileNotFoundError:
        return None
    except json.JSONDecodeError:
        tk.messagebox.showerror("Error", "coordinates.json is corrupted. Please delete it and recalibrate.")
        return None

def save_coordinates(coordinates):
    """Save coordinates to file"""
    with open(get_data_path("coordinates.json"), "w") as f:
        json.dump(coordinates, f, indent=2)

