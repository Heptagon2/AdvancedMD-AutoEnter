def choose_gemini_api_key():
    """Randomly choose one of the configured Gemini API keys.

    Considers environment variables GEMINI_API_KEY, GEMINI_API_KEY2, GEMINI_API_KEY3.
    Each configured key has an equal chance of being selected. If no keys are set,
    returns (None, None).
    """
    key_names = ["GEMINI_API_KEY", "GEMINI_API_KEY2", "GEMINI_API_KEY3"]
    available = []
    for name in key_names:
        value = os.getenv(name)
        if value:
            available.append((name, value))

    if not available:
        return None, None

    return random.choice(available)

def convert_pdf_to_images(pdf_path, output_folder="output_images"):
    os.makedirs(output_folder, exist_ok=True)
    images = convert_from_path(pdf_path, dpi=300)
    
    image_path = []
    for i, img in enumerate(images):
        img_pathSingle = os.path.join(output_folder, f"page_{i+1}.png")
        img.save(img_pathSingle, "PNG")
        image_path.append(img_pathSingle)
    
    return image_path

def load_coordinates():
    """Load saved coordinates from file"""
