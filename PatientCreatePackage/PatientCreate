            # If Gemini returned a valid positive integer index, move selection and confirm
            try:
                idx = int(city_index)
                if idx <= 0:
                    # Fallback: no reliable city match; skip auto-selection and
                    # prevent auto-save later.
                    print("City identification returned 0 (fallback); skipping city auto-selection and later auto-save.")
                    city_selection_ok = False
                else:
                    # Guardrail: avoid moving too far even if Gemini gives a bad index.
                    # Treat very large indices as suspicious and skip auto-save.
                    max_allowed_index = 10
                    if idx > max_allowed_index:
                        print(f"City index {idx} is greater than max_allowed_index {max_allowed_index}; treating as failure and skipping auto-save.")
                        city_selection_ok = False
                    else:
                        moves = max(0, idx - 1)
                        print(f"Moving down {moves} time(s) to reach city index {idx}.")
                        for _ in range(moves):
                            pyautogui.press('down')
                            time.sleep(0.1)
            except ValueError:
                print(f"City index '{city_index}' is not a valid integer; skipping auto-selection.")
        except Exception as e:
            print(f"Error identifying city selection from dropdown: {e}")
        pyautogui.press('tab')
    except Exception as e:
        print(f"Error entering ZIP Code: {e}")
    
    time.sleep(0.5)

    #Enter Phone Number
    pyauto_tab(3)
    print(f"Entering Phone Number: {PrimaryPhoneNumber}")
    pyauto_enter_data(PrimaryPhoneNumber)

    #Enter Sex
    pyauto_tab(7)
    time.sleep(0.5)
    print(f"Entering Sex: {Sex}")
    pyauto_enter_data(Sex)

    #press save
    pyauto_tab(23)

    # If city selection failed (index 0), stop here before duplicate check/save
    if not city_selection_ok:
        print("City identification fallback detected; stopping before duplicate check and auto-save.")
        return
    
    # Check for duplicate patient warning before saving
    try:
        screenshot_active_monitor()
        duplicate_check_image = "monitor_under_mouse.png"
        is_duplicate = check_for_duplicate_patient(duplicate_check_image)
        print(f"Duplicate patient check: {is_duplicate}")
        
        if is_duplicate:
            print("Duplicate detected")
            try:
                tk.messagebox.showwarning("Possible Patient Duplicate Found", "An orange 'Possible Patient Duplicate Found' banner was detected. Please review the record before saving.")
            except Exception as e:
                print(f"Error showing duplicate warning messagebox: {e}")
        else:
            pyautogui.press('enter')
    except Exception as e:
        print(f"Error during duplicate check: {e}")
        # If check fails, don't auto-save to be safe
        print("Skipping auto-save due to error.")
    
    print("Data entry completed!")

class PatientCreateApp:
    def __init__(self, master=None, cli_mode=False):
        self.cli_mode = cli_mode
        self.master = master
        self.hotkey_enabled = False
        self.calibration_step_event = threading.Event()
        self.calibrating = False
        if not cli_mode:
            self.master.title("PatientCreate - AutoEnter V3")
            self.status_var = tk.StringVar()
            self.status_label = tk.Label(master, textvariable=self.status_var)
            self.status_label.pack()
            self.main_frame = tk.Frame(master)
            self.main_frame.pack()
            # Slow mode checkbox state for tabbing speed
            self.slowmode_var = tk.BooleanVar(value=False)
            self.build_gui()
            self.review_frame = None
            self.quit_btn = tk.Button(master, text="Quit", command=self.quit_app)
            self.quit_btn.pack(pady=5)
            self.master.protocol("WM_DELETE_WINDOW", self.quit_app)
            keyboard.add_hotkey('`', self.global_hotkey_handler)
        self.coordinates = None
        self.image_paths = []
        self.current_idx = 0
        self.patient_data = None
        self.review_entries = []
        if not self.cli_mode:
            self.coordinates = load_coordinates()
            if not self.coordinates:
                self.show_info("No saved coordinates found. Please calibrate before continuing.")

    def log(self, msg):
        if self.cli_mode:
            print(msg)
        else:
            self.status_var.set(msg)
            self.master.update_idletasks()

    def ask_input(self, prompt):
        if self.cli_mode:
            return input(prompt)
        else:
            # Simple input dialog
            from tkinter.simpledialog import askstring
            return askstring("Input", prompt)

    def ask_yesno(self, prompt):
        if self.cli_mode:
            return input(f"{prompt} (yes/no): ").strip().lower() in ["yes", "y"]
        else:
            return tk.messagebox.askyesno("Confirm", prompt)

    def show_error(self, msg):
        if self.cli_mode:
            print(f"ERROR: {msg}")
        else:
            tk.messagebox.showerror("Error", msg)

    def show_info(self, msg):
        if self.cli_mode:
            print(msg)
        else:
            tk.messagebox.showinfo("Info", msg)

    def build_gui(self):
        self.select_btn = tk.Button(self.main_frame, text="Select Input File", command=self.select_input_gui)
        self.select_btn.pack(padx=100,pady=5)
        self.calib_btn = tk.Button(self.main_frame, text="Calibrate Positions", command=self.calibrate_positions_gui)
        self.calib_btn.pack(pady=5)
        # Toggle hotkey/manual mode
        self.toggle_btn = tk.Button(self.main_frame, text="Hotkey Mode: OFF", command=self.toggle_hotkey_mode)
        self.toggle_btn.pack(pady=5)

        # Slow mode checkbox for pyauto_tab
        def on_slowmode_toggle():
            global SLOWMODE_ENABLED
            SLOWMODE_ENABLED = bool(self.slowmode_var.get())

        self.slowmode_check = tk.Checkbutton(
            self.main_frame,
            text="Slow mode (slow tabs)",
            variable=self.slowmode_var,
            command=on_slowmode_toggle,
        )
        self.slowmode_check.pack(pady=5)

    def select_input_gui(self):
        self.image_paths = select_input()
        if self.image_paths:
            self.log(f"Selected {len(self.image_paths)} images.")
            self.process_images(self.image_paths)

    def calibrate_positions_gui(self):
        self.calibrating = True
        try:
            # Show example image of patient white space during calibration
            if hasattr(self, "whitespace_example_window") and self.whitespace_example_window is not None:
                try:
                    self.whitespace_example_window.destroy()
                except Exception:
                    pass
            self.whitespace_example_window = tk.Toplevel(self.master)
            self.whitespace_example_window.title("Example of Patient White Space")
            self.whitespace_example_image = tk.PhotoImage(file=resource_path("ExampleOfWhiteSpace.png"))
            lbl = tk.Label(self.whitespace_example_window, image=self.whitespace_example_image)
            lbl.pack()
            instr = (
                "Hover your cursor over the area defined by the red box in the application, "
                "and press the ' ~ ' button to save the location. If you move the application "
                "after calibrating, you will have to calibrate again."
            )
            instr_label = tk.Label(self.whitespace_example_window, text=instr, wraplength=400, justify="left", font=("TkDefaultFont", 11, "bold"))
            instr_label.pack(pady=5)
        except Exception as e:
            print(f"Error showing example white space image: {e}")
        def status_callback(msg):
            self.status_var.set(msg)
            self.master.update_idletasks()
        def run_calibration():
            coords = self.calibrate_positions(gui_status_callback=status_callback)
            def finish_calibration():
                self.coordinates = coords
                save_coordinates(self.coordinates)
                self.log("Calibration complete.")
                self.calibrating = False
            self.master.after(0, finish_calibration)
        threading.Thread(target=run_calibration, daemon=True).start()

    def calibrate_positions(self, gui_status_callback=None):
        print("Calibrating cursor positions...")
        print("For each field, hover your mouse over the text box and press ` to save the position")
        print("You can press Ctrl+C at any time to cancel calibration")
        coordinates = {}
        fields = [
            ("Patient White Space", "whitespacexy"),
        ]
        for field_name, coord_key in fields:
            if gui_status_callback:
                gui_status_callback(f"Calibrating: {field_name}")
            print(f"\nHover over {field_name} text box and press ` to save position")
            print("Press Ctrl+C to cancel")
            self.calibration_step_event.clear()
            while True:
                try:
                    if self.calibration_step_event.wait(timeout=0.1):
                        break
                except KeyboardInterrupt:
                    print("\nCalibration cancelled.")
                    sys.exit(1)
                print(f"\rCurrent position: {pyautogui.position()}", end="", flush=True)
            position = pyautogui.position()
            coordinates[coord_key] = {"x": position.x, "y": position.y}
            print(f"\n{field_name} position saved: {position}")
            time.sleep(0.5)
        if gui_status_callback:
            gui_status_callback("")
        return coordinates

    def quit_app(self):
        if self.cli_mode:
            exit(0)
        else:
            self.master.destroy()

    def global_hotkey_handler(self):
        if self.calibrating:
            self.calibration_step_event.set()
        elif self.hotkey_enabled:
            self.take_and_process_screenshot()

    def take_and_process_screenshot(self):
        screenshot_active_monitor()
        image_path = "monitor_under_mouse.png"
        self.process_images([image_path])

    def process_images(self, image_paths):
        if not self.coordinates:
            self.coordinates = load_coordinates()
        if not self.coordinates:
            self.show_info("No saved coordinates found. Please calibrate before continuing.")
            self.calibrate_positions_gui()
            if not self.coordinates:
                self.show_error("Calibration failed or cancelled. Cannot continue.")
                return
        for idx, image_path in enumerate(image_paths):
            self.log(f"Processing {image_path} ({idx+1}/{len(image_paths)})...")
            response = extract_patient_info(image_path)
            if response is None:
                self.show_error(f"Failed to extract info from {image_path}")
                continue
            patient_data = unpack_response(response)
            if patient_data is None:
                self.show_error(f"Failed to parse info from {image_path}")
                continue
            self.patient_data = patient_data
            confirmed, edited_data = self.review_and_confirm(patient_data)
            if not confirmed:
                self.log("Data entry cancelled or not confirmed. Skipping this entry.")
                continue
            # enter_data is now called from review_and_confirm
            try:
                os.remove(image_path)
                self.log(f"Deleted {image_path}")
            except Exception as e:
                self.show_error(f"Could not delete {image_path}: {e}")
        #self.show_info("Batch processing complete!")

    def review_and_confirm(self, patient_data):
        if self.cli_mode:
            # Terminal mode: print and allow manual edit (on main combined fields)
            field_order = [
                ("PatientName", "Name"),
                ("DateOfBirth", "Date of Birth"),
                ("MRNNumber", "MRN Number"),
                ("Sex", "Sex"),
                ("PrimaryPhoneNumber", "Primary Phone Number"),
                ("Address", "Address"),
                ("SecondaryAddress", "Secondary Address"),
                ("City", "City"),
                ("ZipCode", "ZIP"),
            ]
            edited = dict(patient_data)
            for key, label in field_order:
                current = edited.get(key, "")
                print(f"{label}: {current}")
                resp = input(f"Edit {label}? (leave blank to keep): ").strip()
                if resp:
                    edited[key] = resp

            # Recompute separated name fields from PatientName
            name = edited.get("PatientName", "").strip()
            last_name = edited.get("LastName", "")
            first_name = edited.get("FirstName", "")
            middle_name = edited.get("MiddleName", "")
            if name:
                if "," in name:
                    parts = [p.strip() for p in name.split(",", 1)]
                    last_name = parts[0]
                    rest = parts[1] if len(parts) > 1 else ""
                    rest_parts = rest.split()
                    if rest_parts:
                        first_name = rest_parts[0]
                        if len(rest_parts) > 1:
                            middle_name = " ".join(rest_parts[1:])
                else:
                    parts = name.split()
                    if len(parts) == 1:
                        last_name = parts[0]
                    elif len(parts) == 2:
                        last_name, first_name = parts
                    elif len(parts) >= 3:
                        last_name = parts[0]
                        first_name = parts[1]
                        middle_name = " ".join(parts[2:])

            edited["LastName"] = last_name
            edited["FirstName"] = first_name
            edited["MiddleName"] = middle_name

            confirm = input("Is the extracted information correct? (yes/no): ").strip().lower() in ["yes", "y"]
            if not confirm:
                print("Data entry cancelled.")
                return False, edited
            ready = input("Are you ready to paste the information? (yes/no): ").strip().lower() in ["yes", "y"]
            if not ready:
                print("Data entry cancelled.")
                return False, edited
            return True, edited

        else:
            # GUI mode: show editable fields in a modal dialog with separate name fields
            result = {'confirmed': False, 'edited': dict(patient_data)}
            dialog = tk.Toplevel(self.master)
            dialog.title("Review Extracted Data")

            field_order = [
                ("LastName", "Last Name"),
                ("FirstName", "First Name"),
                ("MiddleName", "Middle Name"),
                ("DateOfBirth", "Date of Birth"),
                ("MRNNumber", "MRN Number"),
                ("Sex", "Sex"),
                ("PrimaryPhoneNumber", "Primary Phone Number"),
                ("Address", "Address"),
                ("SecondaryAddress", "Secondary Address"),
                ("City", "City"),
                ("ZipCode", "ZIP"),
            ]

            entries = []
            for i, (key, label) in enumerate(field_order):
                tk.Label(dialog, text=label).grid(row=i, column=0, sticky='e', padx=5, pady=2)
                entry = tk.Entry(dialog, width=40)
                entry.insert(0, str(patient_data.get(key, "")))
                entry.grid(row=i, column=1, padx=5, pady=2)
                entries.append((key, entry))

            # Add warning label
            warning = tk.Label(dialog, text="Please ensure the target application is active and ready to receive input. You have 5 seconds to switch to the target application before auto-entry begins.", fg="red", wraplength=350, justify="left")

            warning.grid(row=len(field_order), column=0, columnspan=2, pady=(10,0))
            def on_confirm():
                # Update edited dict from entry widgets
                for key, entry in entries:
                    result['edited'][key] = entry.get()

                # Reconstruct PatientName from separate name fields
                last_name = result['edited'].get("LastName", "").strip()
                first_name = result['edited'].get("FirstName", "").strip()
                middle_name = result['edited'].get("MiddleName", "").strip()
                
                # Build PatientName in "Last, First Middle" format
                if middle_name and middle_name != "~":
                    patient_name = f"{last_name}, {first_name} {middle_name}"
                else:
                    patient_name = f"{last_name}, {first_name}"
                
                result['edited']["PatientName"] = patient_name

                result['confirmed'] = True
                dialog.destroy()
                # Start auto-entry after closing dialog
                self.master.after(100, lambda: self.master.after(5000, lambda: enter_data(self.coordinates, result['edited'])))
            def on_cancel():
                result['confirmed'] = False
                dialog.destroy()
            btn_frame = tk.Frame(dialog)
            btn_frame.grid(row=len(field_order)+1, column=0, columnspan=2, pady=10)
            confirm_btn = tk.Button(btn_frame, text="Confirm and Continue", command=on_confirm)
            confirm_btn.pack(side='left', padx=5)
            cancel_btn = tk.Button(btn_frame, text="Cancel Entry", command=on_cancel)
            cancel_btn.pack(side='left', padx=5)
            dialog.transient(self.master)
            dialog.grab_set()
            self.master.wait_window(dialog)
            if not result['confirmed']:
                return False, patient_data
            return True, result['edited']

    def toggle_hotkey_mode(self):
        self.hotkey_enabled = not self.hotkey_enabled
        if self.hotkey_enabled:
            self.toggle_btn.config(text="Hotkey Mode: ON")
        else:
            self.toggle_btn.config(text="Hotkey Mode: OFF")

