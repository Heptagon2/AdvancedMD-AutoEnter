def calibrate_positions(gui_status_callback=None):
    """Calibrate cursor positions for all form fields"""
    print("Calibrating cursor positions...")
    print("For each field, hover your mouse over the text box and press ` to save the position")
    print("You can press Ctrl+C at any time to cancel calibration")
    
    coordinates = {}
    fields = [
        ("Patient White Space", "whitespacexy")
    ]
    
    for field_name, coord_key in fields:
        if gui_status_callback:
            gui_status_callback(f"Calibrating: {field_name}")
        print(f"\nHover over {field_name} text box and press ` to save position")
        print("Press Ctrl+C to cancel")
        
        stop_event = threading.Event()
        
        def listen_for_kill_key():
            try:
                keyboard.wait('~')
                stop_event.set()
            except KeyboardInterrupt:
                print("\nCalibration cancelled.")
                sys.exit(1)
        
        # Start the kill-key listener in the background
        threading.Thread(target=listen_for_kill_key, daemon=True).start()
        
        # Main loop: print mouse position until kill key is pressed
        while not stop_event.is_set():
            try:
                print(f"\rCurrent position: {pyautogui.position()}", end="", flush=True)
                time.sleep(0.1)
            except KeyboardInterrupt:
                print("\nCalibration cancelled.")
                sys.exit(1)
        
        position = pyautogui.position()
        coordinates[coord_key] = {"x": position.x, "y": position.y}
        print(f"\n{field_name} position saved: {position}")
        stop_event.clear()
        time.sleep(0.5)
    
    if gui_status_callback:
        gui_status_callback("")
    return coordinates

def screenshot_active_monitor():
    """Capture screenshot of the monitor where the mouse is currently located.

    Uses Win32 APIs to get accurate per-monitor coordinates (DPI-aware), then
    captures that exact rectangle using mss.grab(bbox).
    """
    # Get mouse position
    mouse_x, mouse_y = pyautogui.position()
    print(f"Mouse position: ({mouse_x}, {mouse_y})")

    # Get all monitor info using ctypes for accurate dimensions
    user32 = ctypes.windll.user32

    def get_monitors_info():
        """Get accurate monitor information using Windows API"""
        monitors = []

        class RECT(ctypes.Structure):
            _fields_ = [
                ("left", ctypes.c_long),
                ("top", ctypes.c_long),
                ("right", ctypes.c_long),
                ("bottom", ctypes.c_long),
            ]

        @ctypes.WINFUNCTYPE(ctypes.c_int, ctypes.c_ulong, ctypes.c_ulong, ctypes.POINTER(RECT), ctypes.c_double)
        def callback(hMonitor, hdcMonitor, lprcMonitor, dwData):
            info = lprcMonitor.contents
            monitors.append(
                {
                    "left": info.left,
                    "top": info.top,
                    "width": info.right - info.left,
                    "height": info.bottom - info.top,
                }
            )
            return 1

        user32.EnumDisplayMonitors(0, 0, callback, 0)
        return monitors

    monitors = get_monitors_info()
    print(f"Total monitors detected: {len(monitors)}")

    # Find which monitor contains the mouse
    monitor_index = None
    target_monitor = None

    for i, monitor in enumerate(monitors, start=1):
        print(
            f"  Monitor {i}: left={monitor['left']}, top={monitor['top']}, "
            f"width={monitor['width']}, height={monitor['height']}"
        )

        x1 = monitor["left"]
        y1 = monitor["top"]
        x2 = x1 + monitor["width"]
        y2 = y1 + monitor["height"]

        print(f"  Checking Monitor {i}: x=[{x1}, {x2}), y=[{y1}, {y2})")

        if x1 <= mouse_x < x2 and y1 <= mouse_y < y2:
            monitor_index = i
            target_monitor = monitor
            print(f"  -> Mouse is on Monitor {i}")
            break

    # Fallback to first monitor if mouse position doesn't match any monitor
    if target_monitor is None:
        print("Warning: Mouse position doesn't match any monitor bounds. Using first monitor.")
        if monitors:
            target_monitor = monitors[0]
            monitor_index = 1
        else:
            # No monitors reported; bail out gracefully
            print("No monitors reported by Win32 API; cannot capture screenshot.")
            return

    print(f"Capturing Monitor {monitor_index}: {target_monitor}")

    # Use mss to capture the specific region. We pass an explicit bbox so we
    # don't rely on mss's own monitor list (which can be DPI-scaled).
    bbox = (
        target_monitor["left"],
        target_monitor["top"],
        target_monitor["left"] + target_monitor["width"],
        target_monitor["top"] + target_monitor["height"],
    )

    with mss.mss() as sct:
        sct_img = sct.grab(bbox)

    output_path = "monitor_under_mouse.png"
    mss.tools.to_png(sct_img.rgb, sct_img.size, output=output_path)

    print(f"Screenshot saved: {output_path}")
    print(f"  Captured size: {sct_img.width}x{sct_img.height}")
    print(f"  Expected size: {target_monitor['width']}x{target_monitor['height']}")
    print(f"  Position: ({target_monitor['left']}, {target_monitor['top']})")

def identify_city_option_from_image(image_path, city_name, zip_code):
    """Use Gemini to identify which city option index matches the given city_name and ZIP code.

    Returns: index_str - integer index (1-based) as a string, e.g. "1", "2", "3"; "0" if no match.
    """
    try:
        key_name, api_key = choose_gemini_api_key()
        if not api_key:
            raise ValueError("GEMINI_API_KEY not found in environment variables. Please check your .env file.")
        genai.configure(api_key=api_key)

        with open(image_path, "rb") as f:
            image_bytes = f.read()

        model = genai.GenerativeModel(model_name="gemini-2.5-flash-lite")

        prompt = f"""You are looking at a screenshot that contains a dropdown list of cities.
The city we want to select in the dropdown is: "{city_name}" and the ZIP code must be: "{zip_code}".

Your job is to choose which VISIBLE DROPDOWN OPTION the user should select.

HOW TO NUMBER OPTIONS (SelectedIndex):
- Look ONLY at the visible options in the dropdown list. The first option in the dropdown list is a darker grey than the rest.
- Number them from TOP to BOTTOM starting at 1.
  - The top visible option has SelectedIndex = 1.
  - The second visible option has SelectedIndex = 2.
  - The third visible option has SelectedIndex = 3, and so on.

MATCHING RULES (CITY + ZIP MUST MATCH):
- Only consider an option a valid match if BOTH are true:
  1) Its CITY NAME matches "{city_name}" (ignore case and minor punctuation), AND
  2) Its ZIP CODE matches "{zip_code}" (ignore spaces and minor formatting).
- If exactly one option clearly corresponds to both the requested city and ZIP, that option's position is the SelectedIndex.
- If there is NO good match, or you cannot see any city list or ZIP codes, the SelectedIndex MUST be 0.

Output format (VERY IMPORTANT):
- Output EXACTLY ONE line containing only the SelectedIndex as an integer (0, 1, 2, 3, ...).
- Do NOT output any other text, labels, explanations, or punctuation.
"""

        response = model.generate_content([
            {
                "role": "user",
                "parts": [
                    {"inline_data": {"mime_type": "image/png", "data": image_bytes}},
                    {"text": prompt},
                ],
            }
        ])

        text = response.text.strip()
        lines = [line.strip() for line in text.splitlines() if line.strip()]

        index_text = "0"

        if lines:
            # Basic sanitation: keep only leading integer-like content on first line
            match = re.match(r"^(-?\d+)", lines[0])
            if match:
                index_text = match.group(1)

        return index_text
    except Exception as e:
        print(f"Error identifying city option from image: {e}")
        return "0"

def check_for_duplicate_patient(image_path):
    """Check if a duplicate patient warning banner is present in the screenshot.
    
    Uses OpenCV template matching to compare the full screenshot
    against FlagTemplate.png.

    Returns: bool - True if duplicate warning detected, False otherwise.
    """
    try:
        # Load the screenshot (use full image for matching)
        screenshot = cv2.imread(image_path)
        if screenshot is None:
            print(f"Error: Could not load screenshot from {image_path}")
            return False

        height, width = screenshot.shape[:2]

        # Load the flag template
        template_path = resource_path("FlagTemplate.png")
        template = cv2.imread(template_path)
        if template is None:
            print(f"Error: Could not load FlagTemplate.png from {template_path}")
            return False
        
        # Get template dimensions
        template_height, template_width = template.shape[:2]
        
        # Check if template is larger than the search region
        if template_height > height or template_width > width:
            print(f"Warning: Template ({template_width}x{template_height}) is larger than search region ({width}x{height})")
            return False
        
        # Perform template matching
        result = cv2.matchTemplate(screenshot, template, cv2.TM_CCOEFF_NORMED)
        
        min_val, max_val, min_loc, max_loc = cv2.minMaxLoc(result)
        
        # Set confidence threshold (adjust as needed)
        confidence_threshold = 0.4
        
        print(f"Duplicate flag template match confidence: {max_val:.3f} (threshold: {confidence_threshold})")
        
        # Return True if confidence exceeds threshold
        is_duplicate = max_val >= confidence_threshold
        
        return is_duplicate
    except Exception as e:
        print(f"Error checking for duplicate patient: {e}")
        return False

