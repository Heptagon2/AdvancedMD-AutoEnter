        # Select model
        model = genai.GenerativeModel(model_name="gemini-2.5-flash")
        
        # Generate response
        response = model.generate_content([
            {
                "role": "user",
                "parts": [
                    {"inline_data": {"mime_type": "image/png", "data": image_bytes}},
                    {"text": """From the image provided, extract ONLY the following patient/member information, in this exact order, one item per line:
1) Last_Name (family name only)
2) First_Name (given name only)
