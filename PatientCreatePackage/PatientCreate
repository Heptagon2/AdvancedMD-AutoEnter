- Do NOT use any number labeled as "ID", "Member ID", "Insurance Number", "Policy Number", "Account Number", or any other identifier.
- If there is no field explicitly labeled "MRN", output only a single '~' for the MRN line.
- If you cannot find an MRN number that is explicitly labeled "MRN", do NOT write 'could not find'; instead output only a single '~' for the MRN line.
- If you cannot find a Middle_Name, or if there is no secondary address line, output only a single '~' for that line.
You must always output exactly eleven lines in this order, no matter what the values are."""}
                ]
            }
        ])
        
        return response.text
    except Exception as e:
        print(f"Error extracting information from image: {e}")
        return None

def unpack_response(response):
    """Parse the AI response into individual fields and clean address/ZIP.

    Returns a dict with at least these keys:
    LastName, FirstName, MiddleName, PatientName, DateOfBirth,
    MRNNumber, Sex, PrimaryPhoneNumber, Address, SecondaryAddress, City, ZipCode.
    """
    try:
        lines = [line.strip() for line in response.strip().split('\n') if line.strip()]

        data = {
            "LastName": "",
            "FirstName": "",
            "MiddleName": "",
            "PatientName": "",
            "DateOfBirth": "",
            "MRNNumber": "",
            "Sex": "",
            "PrimaryPhoneNumber": "",
            "Address": "",
            "SecondaryAddress": "",
            "City": "",
            "ZipCode": "",
        }

        if len(lines) < 11:
            print("Error: AI response doesn't contain enough information.")
            print("You will have to manually change the information.")

            # Field names and labels to prompt the user (combined name)
            field_names = ["PatientName", "DateOfBirth", "MRNNumber", "Sex", "PrimaryPhoneNumber", "Address", "SecondaryAddress", "City", "ZipCode"]
            prompts = ["Patient name", "Date of birth", "MRN Number", "Sex", "Primary phone number", "Primary address", "Secondary address", "City", "ZIP Code"]

            for i, (field, prompt) in enumerate(zip(field_names, prompts)):
                if i < len(lines):
                    value = lines[i]
                else:
                    value = "MISSING"

                print(f"{prompt} is: {value}")
                confirmation = input("Press Enter to confirm, or type 'no' to change: ").strip().lower()
                if confirmation == "no":
                    corrected = input(f"Type in correction for {prompt}: ").strip()
                else:
                    corrected = value

                # For ZipCode, trim to 5 digits
                if field == "ZipCode":
                    corrected = corrected[:5]

                data[field] = corrected

            # Derive Last/First/Middle from combined PatientName if possible
            name = data.get("PatientName", "").strip()
            last_name = ""
            first_name = ""
            middle_name = ""
            if name:
                if "," in name:
                    parts = [p.strip() for p in name.split(",", 1)]
                    last_name = parts[0]
                    rest = parts[1] if len(parts) > 1 else ""
                    rest_parts = rest.split()
                    if rest_parts:
                        first_name = rest_parts[0]
                        if len(rest_parts) > 1:
                            middle_name = " ".join(rest_parts[1:])
                else:
                    # Fallback: split by spaces assuming Last First Middle
                    parts = name.split()
                    if len(parts) == 1:
                        last_name = parts[0]
                    elif len(parts) == 2:
                        last_name, first_name = parts
                    elif len(parts) >= 3:
                        last_name = parts[0]
                        first_name = parts[1]
                        middle_name = " ".join(parts[2:])

            data["LastName"] = last_name
            data["FirstName"] = first_name
            data["MiddleName"] = middle_name

        if len(lines) >= 11:
            # First three lines are Last_Name, First_Name, Middle_Name (or '~' if none)
            last_name = lines[0]
            first_name = lines[1]
            middle_name = lines[2]

            if middle_name == "~" or middle_name.lower() == "could not find":
                patient_name = f"{last_name}, {first_name}"
                middle_name = ""
            else:
                patient_name = f"{last_name}, {first_name} {middle_name}"

            date_of_birth = lines[3]
            mrn_number = lines[4]
            sex = lines[5]
            primary_phone = lines[6]
            address = lines[7]
            secondary_address = lines[8]
            city = lines[9]
            zip_code = lines[10][:5]

            data.update({
                "LastName": last_name,
                "FirstName": first_name,
                "MiddleName": middle_name,
                "PatientName": patient_name,
                "DateOfBirth": date_of_birth,
                "MRNNumber": mrn_number,
                "Sex": sex,
                "PrimaryPhoneNumber": primary_phone,
                "Address": address,
                "SecondaryAddress": secondary_address,
                "City": city,
                "ZipCode": zip_code,
            })

        return data

    except Exception as e:
        print(f"Error parsing AI response: {e}")
        return None

def pyauto_tab(tabamount):
    """Press Tab key tabamount times.

    If SLOWMODE_ENABLED is True, wait 0.05s between each Tab to slow down
    navigation for sensitive UIs.
    """
    global SLOWMODE_ENABLED
    i = 1
    while i <= tabamount:
        pyautogui.press('tab')
        if SLOWMODE_ENABLED:
            time.sleep(0.05)
        i += 1

def pyauto_enter_data(data):
    global SLOWMODE_ENABLED
    try:
        if SLOWMODE_ENABLED:
            pyautogui.write(str(data), interval=0.02)
            time.sleep(0.5)
        else:
            pyautogui.write(str(data), interval=0.01)
            time.sleep(0.3)
    except Exception as e:
        print(f"Error entering Patient Data: {e}")

